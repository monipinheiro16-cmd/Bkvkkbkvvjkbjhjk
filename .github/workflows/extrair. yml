name: Extrair zip
on: workflow_dispatch
permissions:
  contents: write
jobs:
  extrair:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: |
          unzip -q OcarinaMic.zip
          rm -rf OcarinaMic/.github
          cp -r OcarinaMic/. .
          rm -rf OcarinaMic OcarinaMic.zip
      - run: |
          git config user.name "bot"
          git config user.email "bot@users.noreply.github.com"
          git add -A
          git commit -m "Arquivos extraídos"
          git push
